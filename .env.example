# Local development uses the SQLite schema.
DATABASE_URL="file:./dev.db"
NODE_ENV="development"
PORT=3000
# Set to the exact number of trusted reverse-proxy hops when deployed behind a proxy.
TRUST_PROXY_HOPS=""

# Generate a random secret with: openssl rand -base64 48
JWT_SECRET=""
# Optional distinct signing keys; if omitted, JWT_SECRET is used.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Comma-separated exact browser origins (no wildcard with credentialed cookies).
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Comma-separated user IDs authorized to post ledger credits.
# Leave empty unless controlled operators are configured.
LEDGER_CREDIT_USER_IDS=""

# For staging/production, use the PostgreSQL schema and a managed PostgreSQL URL:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/kennedy?schema=public"

# Optional external integrations.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL=""
FRONTEND_URL=""
